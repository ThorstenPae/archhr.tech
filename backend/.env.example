# PostgreSQL connection string (provided by Railway PostgreSQL plugin)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret key for JWT signing (generate a random 64-char string)
JWT_SECRET="your-super-secret-jwt-key-here"

# Environment
NODE_ENV="production"

# Port (Railway sets this automatically)
PORT=3001

# Frontend URL for CORS (your Vercel deployment URL)
FRONTEND_URL="https://archhr-tech.vercel.app"
